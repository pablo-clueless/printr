{
  "name": "@pablo_clueless/printr",
  "version": "0.1.8",
  "description": "Print Markdown, Word and text files as nicely styled PDFs or Word documents.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "author": "smsnmicheal <smsnmicheal@gmail.com>",
  "homepage": "https://github.com/pablo-clueless/printr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablo-clueless/printr.git"
  },
  "bugs": {
    "url": "https://github.com/pablo-clueless/printr/issues"
  },
  "keywords": [
    "markdown",
    "pdf",
    "cli",
    "puppeteer",
    "markdown-to-pdf",
    "docx",
    "docx-to-pdf",
    "md-to-docx",
    "markdown-to-docx",
    "word",
    "mammoth",
    "print",
    "highlight.js",
    "github-markdown"
  ],
  "bin": {
    "printr": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.22.2",
    "commander": "^12.1.0",
    "glob": "^12.0.0",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.12.1",
    "markdown-it": "^14.3.0",
    "puppeteer": "^25.8.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
